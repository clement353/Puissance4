<Page x:Class="SAE2._2_puissance4.PageParametres"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1A1A1A"
      Title="Paramétrer la partie">

    <Page.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="Margin"      Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Spinner" TargetType="TextBox">
            <Setter Property="Background"  Value="#2C2C2C"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="16"/>
            <Setter Property="Width"       Value="80"/>
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BoutonAction" TargetType="Button">
            <Setter Property="Background"   Value="#2C2C2C"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="Padding"      Value="20,10"/>
            <Setter Property="Margin"       Value="6,0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- Titre + retour -->
            <RowDefinition Height="*"/>    <!-- Contenu -->
            <RowDefinition Height="70"/>   <!-- Bouton Valider -->
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0" Background="#111">
            <Button Content=" Retour"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,0"
                    Background="Transparent"
                    Foreground="#AAA"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Click="BtnRetour_Click"/>
            <TextBlock Text="Paramétrer la partie"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="60,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">

                    <TextBlock Text="Taille de la grille" Style="{StaticResource Label}" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBox x:Name="TxtLignes" Text="6" Style="{StaticResource Spinner}"/>
                        <TextBlock Text="×" Foreground="White" FontSize="18"
                                   VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox x:Name="TxtColonnes" Text="7" Style="{StaticResource Spinner}"/>
                    </StackPanel>
                    <TextBlock Text="(lignes × colonnes)" Foreground="#888" FontSize="11" Margin="0,4"/>

                    <TextBlock Text="Jetons à aligner pour gagner"
                               Style="{StaticResource Label}" FontWeight="Bold"
                               Margin="0,24,0,6"/>
                    <TextBox x:Name="TxtAligner" Text="4" Style="{StaticResource Spinner}"/>

                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,30,0">

                    <TextBlock Text="Mode de jeu" Style="{StaticResource Label}" FontWeight="Bold"/>

                    <RadioButton x:Name="RadioBotBas"
                                 Content="Jouer contre un bot bas niveau"
                                 Style="{StaticResource Radio}"
                                 IsChecked="True"/>
                    <RadioButton x:Name="RadioBotHaut"
                                 Content="Jouer contre un bot haut niveau"
                                 Style="{StaticResource Radio}"/>
                    <RadioButton x:Name="RadioDeuxJoueurs"
                                 Content="Jouer sur le même écran (2 joueurs)"
                                 Style="{StaticResource Radio}"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Temps pour jouer un tour (s)"
                               Style="{StaticResource Label}" FontWeight="Bold"/>
                    <TextBox x:Name="TxtTemps" Text="30" Style="{StaticResource Spinner}"/>
                    <TextBlock Text="(0 = pas de limite)" Foreground="#888" FontSize="11" Margin="0,4"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bouton Valider -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Valider et lancer la partie"
                    Style="{StaticResource BoutonAction}"
                    Background="#1A3A1A"
                    Width="240"
                    Click="BtnValider_Click"/>
        </StackPanel>

    </Grid>
</Page>
