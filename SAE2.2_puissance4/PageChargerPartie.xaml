<Page x:Class="SAE2._2_puissance4.PageChargerPartie"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1A1A1A"
      Title="Charger une partie">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="70"/>
		</Grid.RowDefinitions>

		<!-- En-tête -->
		<Grid Grid.Row="0" Background="#111">
			<Button Content=" Retour"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,0"
                    Background="Transparent"
                    Foreground="#AAA"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnRetour_Click"/>
			<TextBlock Text="Charger une partie"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
		</Grid>

		<!-- Liste des parties sauvegardées -->
		<StackPanel Grid.Row="1" Margin="100,30">
			<TextBlock Text="Parties sauvegardées"
                       Foreground="White"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,15"/>

			<ListBox x:Name="ListParties"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
				Background="#2C2C2C"
                     Foreground="White"
                     FontSize="14"
                     BorderBrush="#555"
                     Height="250">
				 
				<!-- Données fictives (pas de BD) -->
				<ListBoxItem Content="Partie 1 — Joueur vs IA — 24/05/2026"/>
				<ListBoxItem Content="Partie 2 — Joueur vs Joueur — 25/05/2026"/>
				<ListBoxItem Content="Partie 3 — Joueur vs IA — 27/05/2026"/>
				<ListBoxItem Content="Partie 4 — Joueur vs IA — 28/05/2026"/>
			</ListBox>
		</StackPanel>

		<!-- Bouton Charger -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
			<Button Content="Charger la partie sélectionnée"
                    Width="260"
                    Padding="20,10"
                    Background="#1A3A1A"
                    Foreground="White"
                    BorderBrush="#555"
                    FontSize="14"
                    Cursor="Hand"
                    Click="BtnCharger_Click"/>
		</StackPanel>

	</Grid>
</Page>