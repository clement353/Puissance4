<Page x:Class="SAE2._2_puissance4.PageStatistique"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SAE2._2_puissance4"
      mc:Ignorable="d" d:DesignWidth="800"
      Background="#1A1A1A"
      Title="PageStatistique" Height="621">

	<Page.Resources>
		<Style x:Key="TitreSection" TargetType="TextBlock">
			<Setter Property="Foreground"  Value="White"/>
			<Setter Property="FontSize"    Value="16"/>
			<Setter Property="FontWeight"  Value="Bold"/>
			<Setter Property="FontFamily"  Value="Segoe UI"/>
			<Setter Property="Margin"      Value="0,0,0,10"/>
		</Style>
		<Style x:Key="Valeur" TargetType="TextBlock">
			<Setter Property="Foreground"  Value="#AAA"/>
			<Setter Property="FontSize"    Value="14"/>
			<Setter Property="FontFamily"  Value="Segoe UI"/>
			<Setter Property="Margin"      Value="0,4"/>
		</Style>
		<Style x:Key="Carte" TargetType="Border">
			<Setter Property="Background"      Value="#2C2C2C"/>
			<Setter Property="BorderBrush"     Value="#555"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding"         Value="20"/>
			<Setter Property="Margin"          Value="10"/>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- En-tête -->
		<Grid Grid.Row="0" Background="#111">
			<Button Content=" Retour"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,0"
                    Background="Transparent"
                    Foreground="#AAA"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Click="BtnRetour_Click"/>
			<TextBlock Text="Statistiques de votre compte"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
		</Grid>

		<!-- Contenu -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,-179">
			<Grid Margin="20,20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Taux de victoire -->
				<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Carte}">
					<StackPanel>
						<TextBlock Text="Taux de victoire"
                                   Style="{StaticResource TitreSection}"
                                   Foreground="#4CAF50"/>
						<TextBlock Text="(fonctionnalité à venir avec la BD)"
                                   Style="{StaticResource Valeur}"
                                   FontSize="11" Foreground="#666"/>
						<TextBlock Text="Parties jouées : --"
                                   Style="{StaticResource Valeur}"/>
						<TextBlock Text="Victoires : --"
                                   Style="{StaticResource Valeur}"/>
						<TextBlock Text="Taux : -- %"
                                   Style="{StaticResource Valeur}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#4CAF50"/>
					</StackPanel>
				</Border>

				<!-- Taux de défaite -->
				<Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Carte}">
					<StackPanel>
						<TextBlock Text="Taux de défaite"
                                   Style="{StaticResource TitreSection}"
                                   Foreground="#F44336"/>
						<TextBlock Text="(fonctionnalité à venir avec la BD)"
                                   Style="{StaticResource Valeur}"
                                   FontSize="11" Foreground="#666"/>
						<TextBlock Text="Défaites : --"
                                   Style="{StaticResource Valeur}"/>
						<TextBlock Text="Matchs nuls : --"
                                   Style="{StaticResource Valeur}"/>
						<TextBlock Text="Taux : -- %"
                                   Style="{StaticResource Valeur}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#F44336"/>
					</StackPanel>
				</Border>

				<!-- Historique des parties -->
				<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Carte}">
					<StackPanel>
						<TextBlock Text="Historique des parties"
                                   Style="{StaticResource TitreSection}"/>
						<TextBlock Text="(fonctionnalité à venir avec la BD)"
                                   Style="{StaticResource Valeur}"
                                   FontSize="11" Foreground="#666"
                                   Margin="0,0,0,10"/>
						<ListBox Background="#1A1A1A"
                                 Foreground="White"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Height="200"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListBoxItem Content="Partie 1 — Victoire vs IA — 24/05/2026"/>
							<ListBoxItem Content="Partie 2 — Défaite vs Joueur 2 — 25/05/2026"/>
							<ListBoxItem Content="Partie 3 — Victoire vs IA — 27/05/2026"/>
							<ListBoxItem Content="Partie 4 — Match nul vs IA — 28/05/2026"/>
						</ListBox>
					</StackPanel>
				</Border>

				<!-- Niveau moyen des adversaires -->
				<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Carte}">
					<StackPanel>
						<TextBlock Text="Niveau moyen des adversaires"
                                   Style="{StaticResource TitreSection}"/>
						<TextBlock Text="(fonctionnalité à venir avec la BD)"
                                   Style="{StaticResource Valeur}"
                                   FontSize="11" Foreground="#666"/>
						<TextBlock Text="Moyenne : -- elo"
                                   Style="{StaticResource Valeur}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="Gold"
                                   Margin="0,20,0,0"/>
						<TextBlock Text="Adversaire le plus fort : --"
                                   Style="{StaticResource Valeur}"/>
						<TextBlock Text="Adversaire le plus faible : --"
                                   Style="{StaticResource Valeur}"/>
					</StackPanel>
				</Border>

			</Grid>
		</ScrollViewer>

	</Grid>
</Page>
