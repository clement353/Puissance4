<Page x:Class="SAE2._2_puissance4.PageJeu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1A1A1A"
      Title="Jeu">

	<Page.Resources>
		<Style x:Key="BoutonAction" TargetType="Button">
			<Setter Property="Background"      Value="#2C2C2C"/>
			<Setter Property="Foreground"      Value="White"/>
			<Setter Property="FontSize"        Value="13"/>
			<Setter Property="Padding"         Value="14,8"/>
			<Setter Property="Margin"          Value="5,0"/>
			<Setter Property="BorderBrush"    Value="#555"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor"          Value="Hand"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#444"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="70"/>
		</Grid.RowDefinitions>

		<!-- En-tête : retour + timer + joueur actif -->
		<Grid Grid.Row="0" Background="#111">
			<Button Content="Retour"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,0"
                    Background="Transparent"
                    Foreground="#AAA"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Click="BtnRetour_Click"/>


			<TextBlock x:Name="TxtTimer"
                       Text="00 s"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

			<TextBlock x:Name="TxtJoueurActif"
                       Text="Tour : Joueur 1 (X)"
                       FontSize="14"
                       Foreground="#CCC"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="179,0,0,0" Height="20" Width="111"/>
		</Grid>


		<Grid Grid.Row="1" Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="200"/>
			</Grid.ColumnDefinitions>


			<ScrollViewer Grid.Column="0"
                 HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
				<Grid x:Name="GrilleJeu"
                  Grid.Column="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#0D0D0D"/>
			</ScrollViewer>


			<!-- Panneau historique de coup -->
			<StackPanel Grid.Column="1" Margin="15,0,0,0">
				<TextBlock Text="Historique des coups"
                           Foreground="White"
                           FontSize="14" FontWeight="Bold"
                           Margin="0,0,0,10"/>
				<Border BorderBrush="#444" BorderThickness="1">
					<ListBox x:Name="ListHistorique"
                             Background="#111"
                             Foreground="White"
                             FontSize="13"
                             BorderThickness="0"
                             Height="400"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
				</Border>
			</StackPanel>
		</Grid>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

			<Button x:Name="BtnAbandonner"
                    Content="Abandonner"
                    Style="{StaticResource BoutonAction}"
                    Background="#3A1A1A"
                    Click="BtnAbandonner_Click"/>

			<Button x:Name="BtnPause"
                    Content="Pause"
                    Style="{StaticResource BoutonAction}"
                    Click="BtnPause_Click"/>

			<Button x:Name="BtnSauvegarder"
                    Content="Sauvegarder"
                    Style="{StaticResource BoutonAction}"
                    Click="BtnSauvegarder_Click"/>
		</StackPanel>

	</Grid>
</Page>
